<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/inkOnAccent</item>
        <item name="colorPrimaryContainer">@color/accent</item>
        <item name="colorOnPrimaryContainer">@color/inkOnAccent</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/paper</item>
        <item name="colorSecondaryContainer">@color/paperAlt</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorTertiary">@color/ok</item>
        <item name="colorOnTertiary">@color/inkOnOk</item>
        <item name="colorTertiaryContainer">@color/ok</item>
        <item name="colorOnTertiaryContainer">@color/inkOnOk</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/paperAlt</item>
        <item name="colorOnSurfaceVariant">@color/inkMuted</item>
        <item name="colorSurfaceContainerLowest">@color/paper</item>
        <item name="colorSurfaceContainerLow">@color/paper</item>
        <item name="colorSurfaceContainer">@color/paper</item>
        <item name="colorSurfaceContainerHigh">@color/paperAlt</item>
        <item name="colorSurfaceContainerHighest">@color/paperAlt</item>
        <item name="colorOutline">@color/ink</item>
        <item name="colorOutlineVariant">@color/inkDim</item>
        <item name="colorError">@color/accent</item>
        <item name="colorOnError">@color/inkOnAccent</item>

        <item name="cardOutlineColor">@color/ink</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="dividerColor">@color/dividerColor</item>
        <item name="navbarColor">@color/paper</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="textColorOnAccent">@color/inkOnAccent</item>
        <item name="dialogBackground">@color/paper</item>
        <item name="startStopButtonForegroundColor">@color/paper</item>
        <item name="startStopButtonColor_0">@color/accent</item>
        <item name="startStopButtonColor_1">@color/paper</item>
        <item name="startStopButtonColor_2">@color/paperAlt</item>
        <item name="startStopButtonColor_3">@color/paper</item>
        <item name="startStopButtonColor_4">@color/accent</item>
        <item name="startStopButtonColor_5">@color/paper</item>
        <item name="startStopButtonColor_6">@color/paperAlt</item>
        <item name="startStopButtonColor_7">@color/paper</item>
        <item name="startStopButtonColor_8">@color/accent</item>
        <item name="startStopButtonColor_9">@color/paper</item>
        <item name="textColorDanger">@color/accent</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="bottomSheetStyle">@style/AppBottomSheet</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/ink</item>
    </style>

    <style name="AppBottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/paper</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="SnippetCard">
        <item name="android:background">@color/paperAlt</item>
    </style>
</resources>
